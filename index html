        // --- MANEJO DE DROPDOWNS ---
        function populateProductDropdown(selectedId = '') {
            const dropdown = document.getElementById('tanda-product');
            if (!dropdown) return;
            dropdown.innerHTML = '';
            
            state.products.forEach(p => {
                const option = document.createElement('option');
                option.value = p.id;
                option.text = `${p.name} (${formatCurrency(p.price)})`;
                if (p.id === selectedId) option.selected = true;
                dropdown.appendChild(option);
            });

            updateTandaProductAmount();
        }

        function updateTandaProductAmount() {
            const dropdown = document.getElementById('tanda-product');
            const amountInput = document.getElementById('tanda-amount');
            if (!dropdown || !amountInput) return;
            
            const selectedId = dropdown.value;
            const product = state.products.find(p => p.id === selectedId);
            if (product) {
                amountInput.value = product.price;
            }
        }

        // Registrar cambios en el combo de productos
        document.getElementById('tanda-product').addEventListener('change', updateTandaProductAmount);

        // --- APERTURA DE MODALES ---
        window.openTandaModal = function() {
            document.getElementById('tanda-modal-title').innerText = "Registrar Nueva Tanda";
            document.getElementById('tanda-id').value = '';
            document.getElementById('form-tanda').reset();
            
            const hoy = new Date().toISOString().split('T')[0];
            document.getElementById('tanda-date').value = hoy;

            populateProductDropdown();
            document.getElementById('modal-tanda').classList.remove('hidden');
        };

        window.closeTandaModal = function() {
            document.getElementById('modal-tanda').classList.add('hidden');
        };

        window.editTanda = function(id) {
            const t = state.tandas.find(t => t.id === id);
            if (!t) return;

            document.getElementById('tanda-modal-title').innerText = "Editar Tanda";
            document.getElementById('tanda-id').value = t.id;
            document.getElementById('tanda-client').value = t.clientName;
            document.getElementById('tanda-phone').value = t.clientPhone || '';
            document.getElementById('tanda-number').value = t.slotNumber || '';
            document.getElementById('tanda-amount').value = t.totalAmount;
            document.getElementById('tanda-installments').value = t.numInstallments;
            document.getElementById('tanda-frequency').value = t.frequency;
            document.getElementById('tanda-date').value = t.startDate;

            populateProductDropdown(t.productId);
            document.getElementById('modal-tanda').classList.remove('hidden');
